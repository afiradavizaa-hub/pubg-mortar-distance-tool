<Window x:Class="PubgMapDistanceTool.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键设置"
        Width="590"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F2F2F7"
        Foreground="#1C1C1E"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1C1C1E" />
            <Setter Property="Background" Value="#E5E5EA" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogPrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource DialogButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0A84FF" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="快捷键"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#1C1C1E" />
            <TextBlock Text="从全键盘按键中选择，并勾选 Ctrl / Alt / Shift / Win 组成组合键。"
                       Margin="0,5,0,0"
                       FontSize="11.5"
                       Foreground="#6C6C70" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="15"
                Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="116" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="显示 / 隐藏"
                           VerticalAlignment="Center"
                           Foreground="#3A3A3C" />
                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox x:Name="ToggleCtrl"
                              Content="Ctrl"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="ToggleAlt"
                              Content="Alt"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="ToggleShift"
                              Content="Shift"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="ToggleWin"
                              Content="Win"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center" />
                    <ComboBox x:Name="ToggleKeyCombo"
                              Width="150"
                              Height="30"
                              MaxDropDownHeight="310" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="切换校准"
                           VerticalAlignment="Center"
                           Foreground="#3A3A3C" />
                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox x:Name="CalibrationCtrl"
                              Content="Ctrl"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="CalibrationAlt"
                              Content="Alt"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="CalibrationShift"
                              Content="Shift"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="CalibrationWin"
                              Content="Win"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center" />
                    <ComboBox x:Name="CalibrationKeyCombo"
                              Width="150"
                              Height="30"
                              MaxDropDownHeight="310" />
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="切换测距"
                           VerticalAlignment="Center"
                           Foreground="#3A3A3C" />
                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox x:Name="MeasurementCtrl"
                              Content="Ctrl"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="MeasurementAlt"
                              Content="Alt"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="MeasurementShift"
                              Content="Shift"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="MeasurementWin"
                              Content="Win"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center" />
                    <ComboBox x:Name="MeasurementKeyCombo"
                              Width="150"
                              Height="30"
                              MaxDropDownHeight="310" />
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Text="鼠标穿透"
                           VerticalAlignment="Center"
                           Foreground="#3A3A3C" />
                <StackPanel Grid.Row="3"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox x:Name="ClickThroughCtrl"
                              Content="Ctrl"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="ClickThroughAlt"
                              Content="Alt"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="ClickThroughShift"
                              Content="Shift"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="ClickThroughWin"
                              Content="Win"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center" />
                    <ComboBox x:Name="ClickThroughKeyCombo"
                              Width="150"
                              Height="30"
                              MaxDropDownHeight="310" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       MaxWidth="330"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="10"
                       Foreground="#8E8E93"
                       Text="单键可能抢占游戏输入；被 Windows 保留的组合会显示注册失败。" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="取消"
                        Width="82"
                        Margin="0,0,8,0"
                        Style="{StaticResource DialogButton}"
                        Click="CancelButton_Click" />
                <Button Content="保存"
                        Width="88"
                        Style="{StaticResource DialogPrimaryButton}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
